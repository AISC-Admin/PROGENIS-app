# Base de données Postgres (Neon via Vercel Marketplace, ou Supabase)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Secret de signature des sessions (32+ caractères aléatoires) : openssl rand -base64 32
AUTH_SECRET=change-moi-avec-une-longue-chaine-aleatoire

# Code du premier compte manager (utilisé UNE seule fois, quand aucun utilisateur n'existe)
MANAGER_BOOTSTRAP_CODE=PROGENIS-ADMIN-2026

# Vercel Blob (ajouté automatiquement quand vous créez un store Blob dans Vercel)
# Sans ce token, les fichiers sont stockés localement dans ./.uploads (développement uniquement)
BLOB_READ_WRITE_TOKEN=
# "private" (recommandé) ou "public" : doit correspondre au type de store créé dans Vercel
BLOB_ACCESS=private
